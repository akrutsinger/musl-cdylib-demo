/* GNU ld script — build shim, not a real library.
 *
 * rustc unconditionally passes -lgcc_s when linking a cdylib with
 * crt-static disabled. On Fedora the real libgcc_s.so under the gcc
 * directory is itself an ld script:
 *
 *     GROUP ( /lib64/libgcc_s.so.1 libgcc.a )
 *
 * Files named inside a GROUP ignore the command-line --as-needed state,
 * so ld stamps a DT_NEEDED on libgcc_s.so.1 even when nothing references
 * it. That library is linked against glibc's libc.so.6, so the musl
 * loader cannot load it and dlopen() fails with:
 *
 *     Error loading shared library libgcc_s.so.1: No such file or directory
 *
 * An earlier -L (see .cargo/config.toml) makes -lgcc_s resolve to this
 * file instead, pulling in only the static libgcc.a. Archive members are
 * pulled in solely when referenced, so with panic=immediate-abort — which
 * removes the unwinder entirely — nothing is pulled in at all, and musl
 * is left as the .so's only dynamic dependency.
 */
OUTPUT_FORMAT(elf64-x86-64)
GROUP ( libgcc.a )
